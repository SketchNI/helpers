{
    "name": "sketchni/helpers",
    "description": "Some Laravel helpers that I use a lot.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sketch",
            "email": "sketch@sketchni.uk"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3|^8.4",
        "illuminate/support": "^12.0",
        "nesbot/carbon": "3.8.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    }
}
